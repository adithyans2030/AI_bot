# Local LLM via Ollama — https://ollama.com
# Runs fully on this machine: no API key, no credits, no account, no
# external rate limits. Install Ollama, run `ollama pull gemma2:2b` (or
# whatever model you want), and make sure `ollama serve` is running (the
# desktop app does this automatically) before starting the backend.
#
# Model choice matters for latency: if your GPU's VRAM can't hold the
# model, Ollama splits inference across CPU/GPU, which is drastically
# slower (measured ~15x, 163s vs 11s, on a 4GB-VRAM card going from
# llama3.1 (~5.6GB loaded) to gemma2:2b (~2GB loaded)). Pick a model that
# actually fits your hardware.
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma2:2b

# Optional: slide capture. Only used if the teacher clicks "Share slide" —
# if it's never used, none of this matters. A separate, smaller vision
# model than LLM_MODEL: this gets called far more often (every ~10s of
# sharing vs. once per question), so it needs to stay small enough to fit
# in VRAM. `ollama pull moondream` (~1.7GB) before using this feature.
LLM_VISION_MODEL=moondream

# --- Tunable thresholds (all single-sourced from here via app/config.py) ---

# Unit-material chunking (word counts)
CHUNK_MIN_WORDS=150
CHUNK_MAX_WORDS=300

# How many top-matching chunks to retrieve per topic-match
RETRIEVAL_TOP_K=3

# How much recent transcript (seconds) to consider for topic matching
MATCH_WINDOW_SECONDS=90

# Soft score penalty for a chunk already used in a fired question this
# session (nudges repeated triggers toward uncovered material, never a
# hard exclusion)
COVERAGE_REPEAT_PENALTY=0.15
# Above this fraction of unit chunks covered, "Wrap up unit" just reports
# it's covered instead of generating more questions
COVERAGE_WRAP_UP_THRESHOLD=0.8

# Pacing gate: fire a question after this many seconds of silence...
PACING_SILENCE_SECONDS=12
# ...or after this many seconds since the last question, whichever is first
PACING_MAX_INTERVAL_SECONDS=240
# Human priority: hold all questions for this long after anyone in the class
# (heard in the shared Meet tab's audio) speaks. Never logged or reported.
PARTICIPANT_HOLD_SECONDS=15

# --- AI controller ---
# agent = an LLM decides each moment (stay silent / ask / ask the class /
#         wrap up) and code checks every choice; falls back to the pacing
#         rules above if the model is unreachable.
# rules = the fixed pacing gate decides (the original behaviour).
CONTROLLER_MODE=agent
# Model for decisions (defaults to LLM_MODEL). Tested 26 Nov 2026 on four
# classroom moments: gemma2:2b chose well ~11/12 times in ~1 s, but once
# asked while the teacher was mid-sentence; llama3.1 took 13-19 s per
# decision on a 4 GB GPU. Use a stronger hosted model for real classes.
CONTROLLER_MODEL=gemma2:2b
# Consult the AI only after this much quiet, and at most this often
CONTROLLER_MIN_SILENCE_SECONDS=6
CONTROLLER_RECONSULT_SECONDS=20
# Hard limits the AI can never override
MAX_QUESTIONS_PER_HOUR=6
MIN_SECONDS_BETWEEN_QUESTIONS=90
# Drop questions less similar than this to the course notes (cosine, local
# embeddings). On the sample notes, on-topic questions scored 0.42-0.67 and
# off-topic ones 0.10 or less. Calibrate on real lectures.
MIN_GROUNDING_SCORE=0.30
# Planned class length (overridable per session) and the wrap-up window
CLASS_LENGTH_MINUTES=60
WRAP_UP_WINDOW_MINUTES=10

# Local sentence-transformers embedding model (runs fully local, no API cost)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# How often the frontend samples a slide frame while sharing is on
SLIDE_CAPTURE_INTERVAL_SECONDS=10
# A slide read older than this falls back to transcript-only matching
SLIDE_STALENESS_SECONDS=30
# Skip the vision call when the new frame looks unchanged from the last
# processed one (mean pixel diff on a 16x16 grayscale thumbnail, 0-1)
SLIDE_FRAME_DIFF_THRESHOLD=0.05

# --- Moodle LTI 1.3 sign-in ---
# false = local development: no sign-in, everyone is a local developer.
# true  = every real deployment: only teachers who launch from Moodle get in.
AUTH_REQUIRED=false
# Public https address of this server, exactly as Moodle reaches it.
TOOL_BASE_URL=http://localhost:8000
# Values Moodle shows after the admin registers the tool (Site administration
# > Plugins > External tool > Manage tools). Issuer = the Moodle site URL.
LTI_PLATFORM_ISSUER=
LTI_CLIENT_ID=
LTI_DEPLOYMENT_IDS=
# Optional overrides (default to Moodle's standard /mod/lti/ endpoints)
# LTI_AUTH_LOGIN_URL=
# LTI_PLATFORM_KEYSET_URL=
# Secret for signing app sessions; generated under data/lti/ if left empty.
APP_SECRET=
# How long a teacher stays signed in after launching (seconds)
APP_TOKEN_TTL_SECONDS=28800
