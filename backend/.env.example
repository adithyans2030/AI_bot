# Local LLM via Ollama — https://ollama.com
# Runs fully on this machine: no API key, no credits, no account, no
# external rate limits. Install Ollama, run `ollama pull gemma2:2b` (or
# whatever model you want), and make sure `ollama serve` is running (the
# desktop app does this automatically) before starting the backend.
#
# Model choice matters for latency: if your GPU's VRAM can't hold the
# model, Ollama splits inference across CPU/GPU, which is drastically
# slower (measured ~15x, 163s vs 11s, on a 4GB-VRAM card going from
# llama3.1 (~5.6GB loaded) to gemma2:2b (~2GB loaded)). Pick a model that
# actually fits your hardware.
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma2:2b

# Optional: slide capture. Only used if the teacher clicks "Share slide" —
# if it's never used, none of this matters. A separate, smaller vision
# model than LLM_MODEL: this gets called far more often (every ~10s of
# sharing vs. once per question), so it needs to stay small enough to fit
# in VRAM. `ollama pull moondream` (~1.7GB) before using this feature.
LLM_VISION_MODEL=moondream

# --- Tunable thresholds (all single-sourced from here via app/config.py) ---

# Unit-material chunking (word counts)
CHUNK_MIN_WORDS=150
CHUNK_MAX_WORDS=300

# How many top-matching chunks to retrieve per topic-match
RETRIEVAL_TOP_K=3

# How much recent transcript (seconds) to consider for topic matching
MATCH_WINDOW_SECONDS=90

# Pacing gate: fire a question after this many seconds of silence...
PACING_SILENCE_SECONDS=12
# ...or after this many seconds since the last question, whichever is first
PACING_MAX_INTERVAL_SECONDS=240

# Local sentence-transformers embedding model (runs fully local, no API cost)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# How often the frontend samples a slide frame while sharing is on
SLIDE_CAPTURE_INTERVAL_SECONDS=10
# A slide read older than this falls back to transcript-only matching
SLIDE_STALENESS_SECONDS=30
# Skip the vision call when the new frame looks unchanged from the last
# processed one (mean pixel diff on a 16x16 grayscale thumbnail, 0-1)
SLIDE_FRAME_DIFF_THRESHOLD=0.05
